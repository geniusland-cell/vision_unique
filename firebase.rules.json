{
  "rules": {
    "users": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth.uid === $uid",

        "role": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "banned": {
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "managers": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null",

      "$managerId": {
        ".read": "auth.uid === $managerId || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth.uid === $managerId"
      }
    },

    "depots": {
      ".read": "auth != null",
      ".write": "auth != null",

      "$depotId": {
        ".read": "auth != null",
        ".write": "(!root.child('depots').child($depotId).exists() && auth != null) || (root.child('depots').child($depotId).child('managed_by').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'admin')",

        "products": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('depots').child($depotId).child('managed_by').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",

          "$productId": {
            ".read": "auth != null",
            ".write": "root.child('depots').child($depotId).child('managed_by').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        },

        "categories": {
          ".read": "auth != null",
          ".write": "root.child('depots').child($depotId).child('managed_by').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "vendors": {
      "$vendorId": {
        ".read": "auth.uid === $vendorId || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth.uid === $vendorId || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "_system": {
      "stats": {
        ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": false
      }
    },

    "audit": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },

    "quartiers": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "votes": {
      ".read": "auth != null",
      ".write": "auth != null",

      "$quarter": {
        ".read": "auth != null",
        ".write": "auth != null",

        "metadata": {
          ".read": "auth != null",
          ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },

        "$depotId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "votes_settings": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$quarter": {
        ".read": "auth != null",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "categories": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$categoryId": {
        ".read": "auth != null",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}
